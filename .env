# Copy to ".env" (same folder as docker-compose.yml): cp .env.example .env
# Docker Compose reads ".env" automatically. No exports needed.

# Absolute path to the project the agent may work in (no ~, no spaces).
# Keep it OUTSIDE this folder, so the agent can't edit the firewall files.
PROJECT_DIR=/home/kalin/Projects/

# Your host user's numeric ID (run `id -u`) so file ownership matches.
# Usually 1000 on Linux; on macOS it's often 501.
HOST_UID=1000

# Claude Code version baked into the image: stable, latest, or e.g. 2.1.89.
# To update: change this, then run `docker compose build claude`.
CLAUDE_VERSION=stable

# Optional headless login (also uncomment the matching line in docker-compose.yml).
# Token from `claude setup-token` run on a machine with a browser (subscription):
# CLAUDE_CODE_OAUTH_TOKEN=
# ...or an API key (billed separately from a Pro/Max subscription):
# ANTHROPIC_API_KEY=
# If you fill these in, keep .env private: chmod 600 .env, never commit it.

# ACP adapter (@agentclientprotocol/claude-agent-acp) version baked into the image.
# ACP_VERSION=0.66.0
